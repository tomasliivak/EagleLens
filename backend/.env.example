PORT=3000

# Supabase project URL.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Key the running API uses for reads. Use the ANON key in production — RLS allows
# public select, so the anon key is all the API needs (and is safe for a server
# whose responses are public).
SUPABASE_ANON_KEY=your-anon-key

# Comma-separated list of frontend origins allowed by CORS in production, e.g.
# https://eaglelens.org . Any *.vercel.app origin is also allowed (preview
# deploys). Leave unset for local dev (all origins allowed).
ALLOWED_ORIGINS=

# Used ONLY by the sync scripts: `npm run sync` (scripts/syncClasses.ts +
# scripts/syncEvals.ts) and `npm run sync:rmp` (scripts/fetchRateMyProf.ts). The
# service-role key bypasses Row Level Security, so keep .env local — never ship it
# to the browser, never commit it, and don't set it on the deployed API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
