# Backend API origin used by the built frontend.
#
# Leave this UNSET for local dev — the app then calls relative '/api/...' paths
# that go through the Vite dev proxy (see vite.config.ts).
#
# In production (e.g. Vercel), set it to the deployed backend origin, no trailing
# slash, e.g. VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_API_BASE_URL=

# Supabase project URL + anon key — used by the frontend for auth and user data
# (reviews). Safe for the browser; RLS is the security boundary. Get both from
# Supabase Settings -> API. Newer Supabase dashboards label the anon key
# "publishable"; it is the same value.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# PostHog browser analytics. The project token is public and safe to expose.
#
# REQUIRED IN DEV: src/lib/posthog.ts throws at import time if either is missing,
# so `npm run dev` renders a blank page until both are set. Production builds
# skip PostHog silently instead.
VITE_POSTHOG_KEY=your-posthog-project-token
VITE_POSTHOG_HOST=https://your-posthog-host
