# Backend API origin used by the built frontend.
#
# Leave this UNSET for local dev — the app then calls relative '/api/...' paths
# that go through the Vite dev proxy (see vite.config.ts).
#
# In production (e.g. Vercel), set it to the deployed backend origin, no trailing
# slash, e.g.:
# VITE_API_BASE_URL=https://your-backend.onrender.com

# Supabase project URL + publishable (anon) key — used by the frontend for
# auth and user data (reviews, saved courses). Safe for the browser; RLS is
# the security boundary. Get both from Supabase Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# prolly not the correct wording for these variables, both are anon but one is publishable?
